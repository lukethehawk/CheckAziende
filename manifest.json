{
  "manifest_version": 3,
  "name": "CheckAziende",
  "version": "1.0.0",
  "description": "Identifica l'azienda del sito aperto e raccoglie dati societari da fonti pubbliche.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://ec.europa.eu/*",
    "https://www.companyreports.it/*",
    "https://xrayfinance.it/*",
    "https://registroaziende.it/*"
  ],
  "action": {
    "default_title": "CheckAziende",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "checkaziende@lukethehawk.github"
    }
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "128": "assets/icons/icon-128.png"
  }
}
