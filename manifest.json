{
  "manifest_version": 3,
  "name": "CheckAziende",
  "version": "0.3.0",
  "description": "Identifica l'azienda del sito aperto e raccoglie dati societari da fonti pubbliche.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://ec.europa.eu/*"
  ],
  "action": {
    "default_title": "CheckAziende",
    "default_popup": "src/popup/popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "checkaziende@lukethehawk.github"
    }
  }
}
